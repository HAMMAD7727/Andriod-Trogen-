# Firebase Configuration for Spy 247 App
# Copy this to your target devices or use Firebase UI to manage per-device configs
FIREBASE_PROJECT_ID=spy247-project
FIREBASE_APP_ID=1:spy247-app:android

# For Controller (Your Phone) - Main hub
# For Family Member (Target Device) - The spyed device
MODE=controller

# Firebase Realtime Database Root Node
DB_ROOT_NODE=/app/spy247

# Optional: Use different database instances for scaling
# DB_INSTANCE_NAME=single-instance-for-all-devices