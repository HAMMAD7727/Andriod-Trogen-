<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A237E"
    android:padding="16dp">

    <!-- Status Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Connection Status Indicator -->
            <View
                android:id="@+id/connection_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#4CAF50"
                android:contentDescription="Connection status"/>

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="medium"
                android:text="Online"/>

            <!-- Stream Count Badge -->
            <TextView
                android:id="@+id/stream_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="#2196F3"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="3 Streams"/>

            <!-- Stream Quality Badge -->
            <TextView
                android:id="@+id/quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#FF9800"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="30 FPS"/>

            <!-- Spacer to push controls -->
            <View
                android:id="@+id/status_spacer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@id/stream_controls"
                app:layout_constraintStart_toEndOf="@id/connection_dot"/>

            <!-- Stream Controls Container -->
            <LinearLayout
                android:id="@+id/stream_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Pause/Play Toggle -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/pause_toggle_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pause"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:text="Pause"
                        app:icon="@android:drawable/ic_menu_media_play"/>

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/status_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Video Preview Container -->
        <androidx.cardview.widget.CardView
            android:id="@+id/video_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <!-- Video View with rounded corners -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>