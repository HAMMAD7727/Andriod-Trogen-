<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A237E"
    android:padding="8dp">

    <!-- Overlay Controls Container -->
    <LinearLayout
        android:id="@+id/overlay_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Device Name Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/device_name_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/device_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Device #001"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Spacer -->
        <View
            android:id="@+id/overlay_spacer_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/pause_toggle_group"/>

        <!-- Pause Toggle Group -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/pause_toggle_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:text="Pause"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Spacer -->
        <View
            android:id="@+id/overlay_spacer_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/mute_toggle_group"/>

        <!-- Mute Toggle Group -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mute_toggle_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mute"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:text="Mute"/>

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <!-- Main Video Container -->
    <FrameLayout
        android:id="@+id/main_video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/overlay_controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Video View with rounded corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/video_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp">

            <!-- Video View -->
            <android.widget.VideoView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>